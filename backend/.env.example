# OpenAI (required for clinical analysis; without it the backend runs in OFFLINE mode)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# Per-request timeout and retry budget for OpenAI calls
OPENAI_TIMEOUT_MS=45000
OPENAI_MAX_RETRIES=2
# Token caps (bound cost + latency)
OPENAI_ANALYSIS_MAX_TOKENS=1500
OPENAI_CHAT_MAX_TOKENS=900

# Per-IP daily request quota (on top of the 15-min burst rate limit)
USER_DAILY_QUOTA=250

# Logging: debug | info | warn | error
LOG_LEVEL=info

# Server
PORT=4000
ALLOWED_ORIGINS=http://localhost:5173
