{
  "name": "percisio-sense",
  "private": true,
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "start": "node backend/index.js",
    "build": "npm run build --prefix frontend",
    "preview": "npm run preview --prefix frontend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "heroku-postbuild": "npm install --prefix backend --omit=dev && npm install --prefix frontend --include=dev && npm run build --prefix frontend"
  }
}
